# =============================================================================
# attention-node (Express Attention Service)
# Copy this file to .env and fill values manually. Do not commit real secrets.
# =============================================================================

PORT=8001

# --- Shared with Main Express (backend-node/.env) ---
# SECRET_KEY MUST match the Main Express backend (JWT validation).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SECRET_KEY=change-me-same-as-main-backend
ALGORITHM=HS256
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
# CORS_ORIGIN_REGEX=

# --- Optional / deploy overrides (Dockerfile sets these on Render) ---
# PYTHON_PATH=/opt/attention-venv/bin/python
# ATTENTION_WORKER_SCRIPT=/app/python_attention_worker/worker.py

# This service is the target of Main Express ATTENTION_SERVICE_URL.
# Default Main → Attention: http://127.0.0.1:8001
