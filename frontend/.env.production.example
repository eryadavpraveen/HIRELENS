# Copy to Vercel/Netlify environment variables (build time).
# Replace URLs with your deployed API hosts.

VITE_API_BASE_URL=https://api-YOUR-APP.onrender.com
VITE_ATTENTION_SERVICE_URL=https://attention-YOUR-APP.onrender.com
VITE_WS_BASE_URL=wss://api-YOUR-APP.onrender.com
VITE_USE_MOCK=false

# WebRTC TURN relay — REQUIRED in production for student/recruiter video+audio.
# Without valid TURN credentials, peers on different networks will never see
# each other's camera/mic (monitoring still works because it uses the WS relay).
# Free key: https://www.metered.ca/tools/openrelay/  (or Twilio / Cloudflare TURN).
VITE_TURN_URLS=turns:YOUR-SUBDOMAIN.relay.metered.ca:443?transport=tcp,turn:YOUR-SUBDOMAIN.relay.metered.ca:80
VITE_TURN_USERNAME=YOUR_TURN_USERNAME
VITE_TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL
