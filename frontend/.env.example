VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_ATTENTION_SERVICE_URL=http://localhost:8001
VITE_WS_BASE_URL=ws://127.0.0.1:8000
VITE_USE_MOCK=false

# WebRTC TURN relay — REQUIRED for student/recruiter video+audio across
# different networks (STUN alone only works on the same LAN).
# Get free credentials at https://www.metered.ca/tools/openrelay/ (or Twilio /
# Cloudflare TURN / self-hosted coturn). Leave blank for same-LAN testing only.
VITE_TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
