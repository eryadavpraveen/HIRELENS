[Unit]
Description=HIRELENS Attention Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hirelens/attention_service
EnvironmentFile=/opt/hirelens/backend/.env
ExecStart=/opt/hirelens/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
