# =============================================================================
# backend-node (Express Main Backend)
# Copy this file to .env and fill values manually. Do not commit real secrets.
# =============================================================================

PORT=8000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SECRET_KEY=change-me-shared-with-attention-node
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
# CORS_ORIGIN_REGEX=

# Express Attention Service (attention-node) — local only; do not tunnel :8001
# Local: http://127.0.0.1:8001
ATTENTION_SERVICE_URL=http://127.0.0.1:8001
ATTENTION_VOICE_TIMEOUT=120
# Optional deploy override (Dockerfile sets these):
# PYTHON_PATH=/opt/vision-venv/bin/python
# VISION_WORKER_SCRIPT=/app/python_vision_worker/worker.py

# --- Cloudinary (verification photo uploads) ---
# Create these in your Cloudinary dashboard; do not reuse/commit real secrets.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=hirelens_images

# --- Optional ---
# PYTHON_PATH=python
# VISION_WORKER_SCRIPT=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# NOTE: VERIFICATION_UPLOAD_DIR is no longer used.
# Verification images are stored in Cloudinary; the URL is saved on
# participants.verification_photo in PostgreSQL.
