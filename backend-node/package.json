{
  "name": "hirelens-backend-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/start-tunnel.ps1",
    "tunnel:detach": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/start-tunnel.ps1 -Detach",
